# Copiar a .env solo si se quiere cambiar algo. Sin .env todo funciona con estos valores por defecto.

# Puertos publicados en el equipo
FRONTEND_PUERTO=4200
BACKEND_PUERTO=3000
MONGO_PUERTO=27017
MAILPIT_PUERTO_WEB=8025

# Base de datos (por defecto, el contenedor mongo). Para usar MongoDB Atlas, poner aquí su cadena.
MONGO_URI=mongodb://mongo:27017/monolegal

# Correo (por defecto, Mailpit). Para enviar correos reales, poner un SMTP real.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
CORREO_REMITENTE=Monolegal <facturacion@monolegal.test>
